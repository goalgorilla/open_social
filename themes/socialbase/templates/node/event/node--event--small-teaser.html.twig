{% extends "node--small-teaser.html.twig" %}

{% block extra_text %}
  <div class="card__text">
    <span class="text-muted">
      {{ event_date }}
      {% if content.ongoing %}
        <span class="badge badge-primary teaser__badge">
          {{ content.ongoing }}
        </span>
      {% endif %}
      {% if event_flag_online or event_flag_enrolled %}
        <div class="event-details">
          {% if event_flag_online %}
            {{ event_flag_online }}
          {% endif %}

          {% if event_flag_enrolled %}
            {{ event_flag_enrolled }}
          {% endif %}
        </div>
      {% endif %}
    </span>
  </div>
{% endblock %}
