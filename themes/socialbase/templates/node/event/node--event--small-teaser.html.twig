{% extends "node--small-teaser.html.twig" %}

{% block extra_text %}
  <div class="card__text">
    <span class="text-muted">
      {{ event_date }}
      {% if content.ongoing %}
        <span class="badge badge-primary teaser__badge">
          {{ content.ongoing }}
        </span>
      {% endif %}
      {% if is_online %}
        {{ event_flag_online }}
        {{ event_flag_enrolled }}
      {% endif %}
    </span>
  </div>
{% endblock %}
