<?php

/**
 * @file
 * Contains Drupal\group_core_comments\group_core_comments.module.
 */

/**
 * Implements hook_theme().
 */
function group_core_comments_theme($existing, $type, $theme, $path) {
  return [
    'comments_join_group' => [
      'variables' => [
        'description' => NULL,
        'group_info' => NULL,
        'action' => NULL,
      ],
    ],
  ];
}
