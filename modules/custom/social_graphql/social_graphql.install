<?php

/**
 * @file
 * Install, update and uninstall functions for the social_graphql module.
 */

/**
 * Implements hook_install().
 */
function social_graphql_install() {
  // Ensure users can use GraphQL powered applications with our default server.
  // We rely on normal access rules for authorization.
  user_role_grant_permissions('anonymous', ['execute open_social_graphql arbitrary graphql requests']);
  user_role_grant_permissions('authenticated', ['execute open_social_graphql arbitrary graphql requests']);
  // Site managers toggle the session-auth opt-out. social_core installs the
  // role before this module; a missing role is a no-op.
  user_role_grant_permissions('sitemanager', ['administer social_graphql settings']);
}

/**
 * Implements hook_update_last_removed().
 */
function social_graphql_update_last_removed() : int {
  return 10101;
}

/**
 * Enable the graphql_oauth module.
 */
function social_graphql_update_25001(): void {
  \Drupal::service('module_installer')->install(['graphql_oauth']);
}

/**
 * Disable GraphQL introspection on the Open Social GraphQL server (PROD-34935).
 */
function social_graphql_update_25002(): string {
  /** @var \Drupal\update_helper\Updater $updater */
  $updater = \Drupal::service('update_helper.updater');

  $updater->executeUpdate('social_graphql', __FUNCTION__);

  return $updater->logger()->output();
}

/**
 * Install the Signed File Upload module.
 */
function social_graphql_update_26001(): void {
  \Drupal::service('module_installer')->install(['signed_file_upload']);
}

/**
 * Default session auth off and grant GraphQL settings to site managers.
 *
 * Writes allow_session_auth only when the key is still unset, so a site
 * that already opted in is not reset if this update runs again.
 */
function social_graphql_update_26002(): void {
  $config = \Drupal::configFactory()->getEditable('social_graphql.settings');
  if ($config->get('allow_session_auth') === NULL) {
    $config->set('allow_session_auth', FALSE)->save();
  }
  user_role_grant_permissions('sitemanager', ['administer social_graphql settings']);
}
