<?php

/**
 * @file
 * The Social User Export module.
 */

use Drupal\Core\StreamWrapper\StreamWrapperManager;
use Drupal\file\Entity\File;

/**
 * Implements hook_file_download().
 */
function social_user_export_file_download(string $uri) {
  $scheme = StreamWrapperManager::getScheme($uri);
  $target = StreamWrapperManager::getTarget($uri);

  // In the following circumstances, this hook doesn't care about the file, and
  // other modules should control access:
  // - The private filesystem is not being used.
  // - There is no target in the uri.
  // - The file doesn't match our CSV export file patterns.
  if ($scheme !== 'private' || $target === FALSE || !preg_match('/^csv\/export-(users|enrollments|members|segment-users)-([a-f0-9]{16})\.csv$/i', $target, $matches)) {
    return NULL;
  }

  // Get the file to see who the owner is.
  $query = \Drupal::entityQuery('file')->accessCheck();
  $query->condition('uri', $uri);
  $fid = $query->execute();

  // Check if file exists.
  if (empty($fid)) {
    return -1;
  }

  /** @var \Drupal\file\FileInterface|null $file */
  $file = File::load(reset($fid));

  if (!$file) {
    return -1;
  }

  $access = FALSE;
  $current_user = \Drupal::currentUser();

  // Determine permission based on an export type.
  // $matches[1] contains the export type (users, enrollments, members or
  // segment-users).
  if ($matches[1] === 'segment-users') {
    // For user segment exports, check 'administer user_segment' permission
    // (if user_segments module is installed) or fall back to
    // 'administer users'.
    $has_permission = $current_user->hasPermission('administer user_segment') ||
      $current_user->hasPermission('administer users');
  }
  else {
    // For standard exports, check 'administer users' permission.
    $has_permission = $current_user->hasPermission('administer users');
  }

  // Allow access to users with the correct permission or file owner.
  if ($has_permission || (string) $current_user->id() === $file->get('uid')->getString()) {
    $access = TRUE;
  }

  // In case the user has access, we send them the file.
  if ($access) {
    return [
      'Content-disposition' => 'attachment; filename="' . basename($target) . '"',
    ];
  }

  // Deny access in all other cases.
  return -1;
}
