<?php

/**
 * @file
 * Install, update and uninstall functions for the module.
 */

/**
 * Implements hook_schema().
 */
function social_email_broadcast_schema(): array {
  // This table contains users' attitude to receiving emails from a platform.
  // The email could be sent from different places (from events - to enrollees,
  // from groups - to group members, etc.) and usually performed by VBO feature.
  // This table contains information regarding users' preferences to receive
  // or not receive such emails.
  $schema['user_email_send'] = [
    'fields' => [
      'id' => [
        'description' => 'Primary Key: Unique row ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'The {user}.uid of user.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'name' => [
        'description' => 'The name of bulk mail.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'frequency' => [
        'description' => 'The frequency the emails should be sent.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => 'immediately',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'ues_uid' => ['uid'],
      'ues_name' => ['name'],
    ],
  ];

  return $schema;
}

/**
 * Add a primary key to the user_email_send table.
 */
function social_email_broadcast_update_26000(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('user_email_send', 'id')) {
    return;
  }

  // Galera and Drupal's READ COMMITTED isolation level need a primary key on
  // every table. A new ID column keeps every existing row, including any
  // duplicate settings rows that a natural key would reject.
  $schema->addField('user_email_send', 'id', [
    'description' => 'Primary Key: Unique row ID.',
    'type' => 'serial',
    'unsigned' => TRUE,
    'not null' => TRUE,
  ], ['primary key' => ['id']]);
}
