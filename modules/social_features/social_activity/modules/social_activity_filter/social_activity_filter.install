<?php

/**
 * @file
 * Install, update and uninstall functions for social_activity_filter module.
 *
 * @deprecated in social:13.0.0 and is removed from social:14.0.0. The activity
 *   filter functionality has been merged into the social_activity module.
 * @see https://www.drupal.org/project/social/issues/3559851
 */

/**
 * Implements hook_install().
 *
 * This deprecated module now only triggers a warning. The actual functionality
 * is provided by social_activity.
 */
function social_activity_filter_install() {
  @trigger_error('social_activity_filter is deprecated in social:13.0.0 and is removed from social:14.0.0. Use social_activity instead. See https://www.drupal.org/project/social/issues/3559851', E_USER_DEPRECATED);
}

/**
 * Implements hook_update_last_removed().
 */
function social_activity_filter_update_last_removed(): int {
  return 8003;
}
