<?php

/**
 * @file
 * The Social activity filter module.
 *
 * @deprecated in social:13.0.0 and is removed from social:14.0.0. The activity
 *   filter functionality has been merged into the social_activity module.
 * @see https://www.drupal.org/project/social/issues/3559851
 */

@trigger_error('social_activity_filter is deprecated in social:13.0.0 and is removed from social:14.0.0. Use social_activity instead. See https://www.drupal.org/project/social/issues/3559851', E_USER_DEPRECATED);

/**
 * Gets default activity views list for filtering.
 *
 * @return array
 *   An array of views IDs that support activity filtering.
 *
 * @deprecated in social:13.0.0 and is removed from social:14.0.0. Use
 *   social_activity_default_views_list() instead.
 * @see https://www.drupal.org/project/social/issues/3559851
 */
function social_activity_filter_default_views_list(): array {
  @trigger_error('social_activity_filter_default_views_list() is deprecated in social:13.0.0 and is removed from social:14.0.0. Use social_activity_default_views_list() instead. See https://www.drupal.org/project/social/issues/3559851', E_USER_DEPRECATED);
  return social_activity_default_views_list();
}
