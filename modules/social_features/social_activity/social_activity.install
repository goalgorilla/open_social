<?php

/**
 * @file
 * The Social activity install.
 */

use Drupal\language\ConfigurableLanguageManagerInterface;
use Drupal\menu_link_content\Entity\MenuLinkContent;

/**
 * Social activity install function.
 */
function social_activity_install() {
  // Add menu item.
  $parents = \Drupal::entityTypeManager()->getStorage('menu_link_content')
    ->loadByProperties(['menu_name' => 'main', 'title' => 'Explore', 'expanded' => TRUE]);
  $parent = reset($parents);
  if ($parent !== FALSE) {
    MenuLinkContent::create([
      'title' => t('Community'),
      'link' => ['uri' => 'internal:/explore'],
      'menu_name' => 'main',
      'expanded' => FALSE,
      'weight' => 10,
      'parent' => 'menu_link_content:' . $parent->uuid(),
    ])->save();
  }

  // Grant activity filter permissions to site managers.
  user_role_grant_permissions('sitemanager', ['administer social_activity_filter']);

  // Set default activity filter settings.
  _social_activity_set_default_filter_settings();
}

/**
 * Sets default tag filter settings for activity streams.
 */
function _social_activity_set_default_filter_settings(): void {
  $config_factory = \Drupal::service('config.factory');
  $config_names = [
    'activity_stream' => [
      'block_stream_explore',
      'block_stream_homepage',
      'block_stream_homepage_without_post',
    ],
    'community_activities' => [
      'block_stream_landing',
    ],
  ];

  // Update activity filter settings.
  $social_activity_filter_config = $config_factory
    ->getEditable('social_activity_filter.settings');

  $blocks = [];
  foreach ($config_names as $config_name => $display_ids) {
    foreach ($display_ids as $display_id) {
      $blocks["{$config_name}__{$display_id}"] = "{$config_name}__{$display_id}";
    }
  }
  // Enable activity filter for blocks.
  $social_activity_filter_config->set('blocks', $blocks);

  // Set default taxonomy vocabularies for activity filter in blocks.
  if (\Drupal::moduleHandler()->moduleExists('social_tagging')) {
    $social_activity_filter_config->set(
      'vocabulary',
      ['social_tagging' => 'social_tagging']
    );
    $social_activity_filter_config->set(
      'taxonomy_fields',
      ['social_tagging' => 'social_tagging']
    );
  }
  $social_activity_filter_config->save();

  // Enable override_tags_filter on the views displays so the filter UI shows.
  foreach ($config_names as $views_id => $display_ids) {
    _social_activity_enable_tags_filter_on_view($views_id, $display_ids);
  }
}

/**
 * Enables the tags filter on specific view displays.
 *
 * @param string $views_id
 *   The view ID.
 * @param array $display_ids
 *   Array of display IDs to enable the filter on.
 */
function _social_activity_enable_tags_filter_on_view(string $views_id, array $display_ids): void {
  $config_factory = \Drupal::service('config.factory');
  $config = $config_factory->getEditable("views.view.{$views_id}");

  // Skip if view doesn't exist.
  if ($config->isNew()) {
    return;
  }

  foreach ($display_ids as $display_id) {
    $override_path = "display.{$display_id}.display_options.override_tags_filter";
    $filter_path = "display.{$display_id}.display_options.filters.activity_filter_tags";

    // Set override_tags_filter to enable the UI.
    $config->set($override_path, 1);

    // Add the filter if it doesn't exist.
    if (!$config->get($filter_path)) {
      $config->set($filter_path, social_activity_get_tag_filter_data());
    }
  }

  $config->save();
}

/**
 * Implements hook_update_dependencies().
 */
function social_activity_update_dependencies() : array {
  // Ensure configurations updates runs after the group migration has completed,
  // but before the group types are removed.
  $dependencies['social_activity'][13000] = [
    'social_group' => 13000,
  ];
  $dependencies['social_group'][13001] = [
    'social_activity' => 13000,
  ];

  return $dependencies;
}

/**
 * Implements hook_update_last_removed().
 */
function social_activity_update_last_removed() : int {
  return 11701;
}

/**
 * Remove deprecated group types.
 */
function social_activity_update_13000(): ?string {
  // Allow platforms to opt out of the group migration, for example if they want
  // to build it themselves and take more scenario's into account than common
  // Open Social installations will have.
  if (\Drupal::state()->get('social_group_group_type_migration_opt_out', FALSE)) {
    \Drupal::logger('social_group')->info('Platform has opted out of group migration.');
    return NULL;
  }

  /** @var \Drupal\update_helper\Updater $updateHelper */
  $updateHelper = \Drupal::service('update_helper.updater');

  // Execute configuration update definitions with logging of success.
  $updateHelper->executeUpdate('social_activity', __FUNCTION__);

  // Output logged messages to related channel of update execution.
  return $updateHelper->logger()->output();
}

/**
 * Change token-replacement from create message template.
 */
function social_activity_update_13001(): void {
  $message_templates = [
    'message.template.create_topic_community',
    'message.template.create_topic_gc',
    'message.template.create_topic_group',
    'message.template.create_event_group',
    'message.template.create_event_gc',
    'message.template.create_event_community',
    'message.template.create_content_in_joined_group',
  ];

  $config_factory = \Drupal::configFactory();
  foreach ($message_templates as $message_template) {
    $config = $config_factory->getEditable($message_template);

    $texts = array_map(function ($text) {
      $text['value'] = str_replace('message:author', 'message:revision_author', $text['value']);

      return $text;
    }, $config->get('text'));

    $config->set('text', $texts)
      ->save();
  }
}

/**
 * Adds no translation property to user profile link HTML in message templates.
 */
function social_activity_update_13002(): void {
  $message_templates = [
    'message.template.create_topic_community',
    'message.template.create_topic_gc',
    'message.template.create_topic_group',
    'message.template.create_event_group',
    'message.template.create_event_gc',
    'message.template.create_event_community',
    'message.template.create_content_in_joined_group',
  ];

  $config_factory = \Drupal::configFactory();
  foreach ($message_templates as $message_template) {
    $config = $config_factory->getEditable($message_template);

    $texts = array_map(function ($text) {
      $text['value'] = str_replace('<a href="[message:revision_author:url:absolute]" translate="no">[message:revision_author:display-name]</a>', '<a href="[message:revision_author:url:absolute]" translate="no">[message:revision_author:display-name]</a>', $text['value']);

      return $text;
    }, $config->get('text'));

    $config->set('text', $texts)
      ->save();
  }
}

/**
 * Update token from message configuration translation .
 */
function social_activity_update_13003(): void {
  $message_templates = [
    'message.template.create_topic_community',
    'message.template.create_topic_gc',
    'message.template.create_topic_group',
    'message.template.create_event_group',
    'message.template.create_event_gc',
    'message.template.create_event_community',
    'message.template.create_content_in_joined_group',
  ];

  $language_manager = \Drupal::languageManager();
  if (!$language_manager instanceof ConfigurableLanguageManagerInterface) {
    return;
  }

  $enabled_languages = $language_manager->getLanguages();

  foreach ($enabled_languages as $language) {
    foreach ($message_templates as $message_template) {
      $config_translation = $language_manager->getLanguageConfigOverride($language->getId(), $message_template);

      $messages = $config_translation->get('text');

      if ($messages) {
        foreach ($messages as $key => $message) {
          $messages[$key]['value'] = str_replace('message:author', 'message:revision_author', $message['value']);
        }

        $config_translation->set('text', $messages)
          ->save();
      }
    }
  }
}

/**
 * Fix message template text values with literal \r\n escape sequences.
 *
 * When message templates use single quotes in YAML, \r\n is stored as literal
 * characters instead of escape sequences, causing them to appear in emails.
 * This update converts those literal strings to actual newline characters.
 */
function social_activity_update_13004(): void {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('message.template.create_content_in_joined_group');

  // Only process if the config exists.
  if ($config->isNew()) {
    return;
  }

  $texts = $config->get('text');
  $updated = FALSE;

  // Check if any text values contain literal \r\n (from single quotes in YAML).
  foreach ($texts as $key => $text) {
    if (isset($text['value']) && strpos($text['value'], '\r\n') !== FALSE) {
      // Replace literal \r\n with actual newline characters.
      $texts[$key]['value'] = str_replace('\r\n', "\r\n", $text['value']);
      $updated = TRUE;
    }
  }

  // Save the config if we made changes.
  if ($updated) {
    $config->set('text', $texts)->save();
  }
}

/**
 * Migrate activity filter functionality from deprecated social_activity_filter.
 *
 * This update handles the migration of the social_activity_filter submodule
 * functionality into the social_activity module. For existing sites:
 * - If social_activity_filter was enabled, it will be uninstalled while
 *   preserving the existing configuration.
 * - If social_activity_filter was not enabled, default filter settings will
 *   be applied.
 */
function social_activity_update_13005(): string {
  $module_handler = \Drupal::moduleHandler();
  $messages = [];

  // Check if social_activity_filter is currently installed.
  $filter_was_enabled = $module_handler->moduleExists('social_activity_filter');

  if ($filter_was_enabled) {
    // The module was installed, so configuration already exists.
    // We just need to uninstall the deprecated module.
    /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
    $module_installer = \Drupal::service('module_installer');

    try {
      // Uninstall social_activity_filter - the config will be preserved since
      // it uses the same config name (social_activity_filter.settings) which
      // is now owned by social_activity.
      $module_installer->uninstall(['social_activity_filter']);
      $messages[] = t('Uninstalled deprecated social_activity_filter module.');
    }
    catch (\Exception $e) {
      $messages[] = t(
        'Could not uninstall social_activity_filter: @error',
        ['@error' => $e->getMessage()]
      );
    }
  }
  else {
    // Module was not installed, set up default configuration and views.
    _social_activity_set_default_filter_settings();
    $messages[] = t('Created default activity filter configuration.');
  }

  // Ensure views displays have override_tags_filter enabled based on config.
  _social_activity_sync_views_filter_settings();
  $messages[] = t('Synchronized activity filter settings with views.');

  // Grant activity filter permissions to site managers if not already granted.
  user_role_grant_permissions('sitemanager', ['administer social_activity_filter']);
  $messages[] = t('Granted activity filter permissions to site managers.');

  return implode(' ', $messages);
}

/**
 * Synchronizes the views filter settings based on the current configuration.
 *
 * Reads the blocks setting from social_activity_filter.settings and ensures
 * the corresponding view displays have override_tags_filter enabled.
 */
function _social_activity_sync_views_filter_settings(): void {
  $config_factory = \Drupal::service('config.factory');
  $config = $config_factory->get('social_activity_filter.settings');

  $blocks = $config->get('blocks') ?? [];

  // Group display IDs by view ID.
  $views_displays = [];
  foreach ($blocks as $block_id => $enabled) {
    if (!$enabled) {
      continue;
    }
    // Block IDs are in format: views_id__display_id.
    $parts = explode('__', $block_id);
    if (count($parts) === 2) {
      [$views_id, $display_id] = $parts;
      $views_displays[$views_id][] = $display_id;
    }
  }

  // Enable the filter on each view's displays.
  foreach ($views_displays as $views_id => $display_ids) {
    _social_activity_enable_tags_filter_on_view($views_id, $display_ids);
  }
}
