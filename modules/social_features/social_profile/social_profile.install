/**
 * Automatically add affiliation when a member joins a Flexible group.
 */
function social_profile_update_250010(): void {
  $affiliation_rules = 'social_profile.automatic_group_affiliations.profile';

  $config = \Drupal::configFactory()->getEditable($affiliation_rules);

  if ($config->isNew()) {
    $config_path = \Drupal::service('extension.list.module')->getPath('social_profile')
      . '/' . InstallStorage::CONFIG_INSTALL_DIRECTORY;
    $source = new FileStorage($config_path);

    \Drupal::service('config.storage')->write(
      name: $affiliation_rules,
      data: (array) $source->read($affiliation_rules)
    );
  }
  else {
    // If the config exists, just append new data.
    $rules = $config->get('rules');
    $rules[] = [
      'weight' => 20,
      'sort' => [
        'by' => 'created',
        'direction' => 'ASC',
      ],
      'retroactive' => FALSE,
      'selectors' => [
        ['type' => 'flexible_group'],
      ],
    ];

    $config->set('rules', $rules);
    $config->save();
  }
}

/**
 * Integrate social_profile_preview into social_profile.
 */
function social_profile_update_250011(): void {
  $moduleHandler = \Drupal::moduleHandler();
  if ($moduleHandler->moduleExists('views') === FALSE ||
    $moduleHandler->moduleExists('user') === FALSE ||
    $moduleHandler->moduleExists('profile') === FALSE
  ) {
    return;
  }

  // Uninstall the social_profile_preview module if it exists.
  if ($moduleHandler->moduleExists('social_profile_preview')) {
    \Drupal::service('module_installer')->uninstall(['social_profile_preview']);
    \Drupal::logger('social_profile')->info('The social_profile_preview module has been uninstalled.');
  }

  $configs_imported = [];
  $configs_failed = [];

  // Import the profile preview view mode configuration.
  $view_mode_config_file = \Drupal::service('extension.list.module')->getPath('social_profile') . '/config/install/core.entity_view_mode.profile.preview.yml';
  if (file_exists($view_mode_config_file)) {
    $view_mode_config = Yaml::parseFile($view_mode_config_file);
    \Drupal::configFactory()->getEditable('core.entity_view_mode.profile.preview')
      ->setData($view_mode_config)
      ->save();
    $configs_imported[] = 'view mode';
  }
  else {
    $configs_failed[] = 'view mode';
  }

  // Import the profile preview view display configuration.
  $view_display_config_file = \Drupal::service('extension.list.module')->getPath('social_profile') . '/config/install/core.entity_view_display.profile.profile.preview.yml';
  if (file_exists($view_display_config_file)) {
    $view_display_config = Yaml::parseFile($view_display_config_file);
    \Drupal::configFactory()->getEditable('core.entity_view_display.profile.profile.preview')
      ->setData($view_display_config)
      ->save();
    $configs_imported[] = 'view display';
  }
  else {
    $configs_failed[] = 'view display';
  }

  if (!empty($configs_imported)) {
    \Drupal::logger('social_profile')->info('Successfully imported profile preview configurations: @configs', ['@configs' => implode(', ', $configs_imported)]);
  }
  if (!empty($configs_failed)) {
    \Drupal::logger('social_profile')->error('Failed to import profile preview configurations: @configs', ['@configs' => implode(', ', $configs_failed)]);
  }
}
