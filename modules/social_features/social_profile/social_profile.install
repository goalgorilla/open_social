/**
 * Make the affiliation enabled by default.
 */
function social_profile_update_250008(): void {
  if (\Drupal::service('social_profile.group_affiliation')
    ->isAffiliationFeatureEnabled()) {
    return;
  }

  $config = \Drupal::configFactory()->getEditable(SocialProfileSettingsForm::SETTINGS);
  $config->set('group_affiliation_status', TRUE);
  $config->save();
}

