################################################################################
#                              Type Information                                #
################################################################################

"""
A social group.
"""
type Group implements Hub & Node {
  """
  UUID of the group.
  """
  id: ID!
  """
  The name of the group.
  """
  name: String!
}

"""
Affiliation with a flexible group. This is the platform affiliation.
"""
type UserGroupAffiliation implements Node & ProfileAffiliatable {
  id: ID!
  function: String
  user: User!
  group: Group!
}

"""
User group membership.
"""
type UserGroupMembership implements Node {
  id: ID!
  joined: DateTime!
  user: User!
  group: Group!
}

type UserGroupMembershipEdge implements Edge {
  cursor: Cursor!
  node: UserGroupMembership!
}

type UserGroupMembershipConnection implements Connection {
  edges: [UserGroupMembershipEdge!]!
  nodes: [UserGroupMembership!]!
  pageInfo: PageInfo!
}

"""
The set of valid sort keys for group membership connections.
"""
enum GroupMembershipSortKeys {
  """Sort by membership creation date (join date)."""
  JOINED_AT
}

################################################################################
#                              Mutation Types                                  #
################################################################################

"""
Input to set the groups of a piece of content.
"""
input ContentInGroupInput {
  """
  The group that owns the content.
  """
  group: ID!
  """
  That field only be used if the crossposted feature is enable at flexible_group configuration.
  The other groups that may view the content. Must not include the group that owns the content. Only applicable when the crossposted feature is enabled for HUBs.
  Should not list the group that owns the content.
  """
  crosspostedGroups: [ID!]
}
