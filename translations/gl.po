#: modules/social_features/social_user/src/Form/SocialUserLoginForm.php:270
msgid ""
"\n"
"        <p>Oops, there was an error. This may have happened for the "
"following reasons:</p>\n"
"        <ul>\n"
"          <li>Invalid username/email and password combination. </li>\n"
"          <li>There has been more than one failed login attempt for this "
"account. It is temporarily blocked. </li>\n"
"          <li>Too many failed login attempts from your computer (IP "
"address). This IP address is temporarily blocked. </li>\n"
"        </ul>\n"
"        <p>To solve the issue, try using different login information, try "
"again later, or <a href=\":url\">request a new password</a></p>"
msgstr "\n        <p>\n        Ups, houbo un erro. Isto pode terse producido polas seguintes razóns:</p>\n        \n        <ul>\n        \n          <li>\n        Combinación de nome de usuario/correo electrónico e contrasinal inválida.</li>\n        \n          <li>\n        Houbo máis dun intento de inicio de sesión fallido nesta conta. Está temporalmente bloqueada.</li>\n        \n          <li>\n        Demasiados intentos de inicio de sesión fallidos desde o teu ordenador (enderezo IP). Este enderezo IP está temporalmente bloqueado.</li>\n        \n        </ul>\n        \n        <p>\n        Para resolver o problema, proba a usar diferentes datos de inicio de sesión, tenta de novo máis tarde ou<a href=\":url\">\n        solicita un novo contrasinal</a>\n        </p>"

#: translations.php:37
msgid ""
"\n"
"        Oops, there was an error. This may have happened for the following "
"reasons: <br>\n"
"        - Invalid username/email and password combination. <br>\n"
"        - There has been more than one failed login attempt for this "
"account. It is temporarily blocked. <br>\n"
"        - Too many failed login attempts from your computer (IP address). "
"This IP address is temporarily blocked. <br> <br>\n"
"        To solve the issue, try using different login information, try again "
"later, or <a href=\":url\">request a new password</a>"
msgstr "\n        Ups, houbo un erro. Isto pode terse producido polas seguintes razóns: \n        - Combinación de nome de usuario/correo electrónico e contrasinal inválida.         - Houbo máis dun intento de inicio de sesión fallido nesta conta. Está temporalmente bloqueada. \n        - Houbo demasiados intentos de inicio de sesión fallidos desde o teu ordenador (enderezo IP). Este enderezo IP está temporalmente bloqueado. \n \n\n        Para resolver o problema, proba a usar diferentes datos de inicio de sesión, tenta de novo máis tarde ou <a href=\":url\n        \">solicita un novo contrasinal"

