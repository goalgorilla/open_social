#: modules/social_features/social_user/src/Form/SocialUserLoginForm.php:270
msgid ""
"\n"
"        <p>Oops, there was an error. This may have happened for the "
"following reasons:</p>\n"
"        <ul>\n"
"          <li>Invalid username/email and password combination. </li>\n"
"          <li>There has been more than one failed login attempt for this "
"account. It is temporarily blocked. </li>\n"
"          <li>Too many failed login attempts from your computer (IP "
"address). This IP address is temporarily blocked. </li>\n"
"        </ul>\n"
"        <p>To solve the issue, try using different login information, try "
"again later, or <a href=\":url\">request a new password</a></p>"
msgstr "\n        <p>\n        Ai, akats bat gertatu da. Hau honako arrazoiengatik gerta daiteke:</p>\n        \n        <ul>\n        \n          <li>\n        Erabiltzaile-izena/posta elektronikoa eta pasahitzaren konbinazio baliogabea.</li>\n        \n          <li>\n        Kontu honekin saio-sarrera saiakera huts gehiago izan dira. Aldi baterako blokeatuta dago.</li>\n        \n          <li>\n        Zure ordenagailutik (IP helbidean) saio-sarrera saiakera huts gehiegi egin dira. IP helbide hau aldi baterako blokeatuta dago.</li>\n        \n        </ul>\n        \n        <p>\n        Arazoa konpontzeko, saiatu saio-informazio desberdinak erabiliz, beranduago berriro saiatu edo<a href=\":url\">\n        pasahitz berri bat eskatu</a>\n        </p>"

#: translations.php:37
msgid ""
"\n"
"        Oops, there was an error. This may have happened for the following "
"reasons: <br>\n"
"        - Invalid username/email and password combination. <br>\n"
"        - There has been more than one failed login attempt for this "
"account. It is temporarily blocked. <br>\n"
"        - Too many failed login attempts from your computer (IP address). "
"This IP address is temporarily blocked. <br> <br>\n"
"        To solve the issue, try using different login information, try again "
"later, or <a href=\":url\">request a new password</a>"
msgstr "\n        Ai, akats bat gertatu da. Hau honako arrazoiengatik gerta daiteke: \n        - Erabiltzaile-izena/posta elektronikoa eta pasahitzaren konbinazio baliogabea.         - Kontu honetarako saio hutsen saiakera bat baino gehiago izan dira. Aldi baterako blokeatuta dago. \n        - Zure ordenagailutik (IP helbideatik) saio hutsen saiakera gehiegi egin dira. IP helbide hau aldi baterako blokeatuta dago. \n \n\n        Arazoa konpontzeko, saiatu saio-informazio desberdinak erabiliz, berriro saiatu beranduago, edo <a href=\":url\n        \">gako berri bat eskatu"

